{
  "tests": [
    {
      "name": "text_to_image",
      "input": {
        "prompt": "A neon shop sign that reads \"QWEN IMAGE 2.1\", rainy night, reflections on wet pavement",
        "resolution": "1k",
        "num_inference_steps": 20,
        "seed": 42
      },
      "timeout": 1800000
    },
    {
      "name": "image_edit",
      "input": {
        "prompt": "Turn this cat into a dog",
        "image_url": "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/cat.png",
        "num_inference_steps": 20,
        "seed": 42
      },
      "timeout": 1800000
    },
    {
      "name": "transparent",
      "input": {
        "prompt": "A cute cartoon dragon sticker.",
        "transparent": true,
        "resolution": "1k",
        "num_inference_steps": 20,
        "seed": 42
      },
      "timeout": 1800000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA L40S",
    "gpuCount": 1,
    "env": [
      { "key": "HF_MODEL", "value": "Qwen/Qwen-Image-2.1" },
      { "key": "PRECISION", "value": "bf16" }
    ],
    "allowedCudaVersions": ["12.9", "12.8"]
  }
}
