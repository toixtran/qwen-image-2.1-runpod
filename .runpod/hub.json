{
  "title": "Qwen Image 2.1",
  "description": "Serverless Qwen/Qwen-Image-2.1: text-to-image, multi-reference image editing (up to 10 images) and native transparent (RGBA) generation.",
  "type": "serverless",
  "category": "image",
  "iconUrl": "https://huggingface.co/front/thumbnails/qwen.png",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 80,
    "gpuCount": 1,
    "gpuIds": "ADA_48_PRO,AMPERE_48,ADA_80_PRO,AMPERE_80,HOPPER_141,ADA_24",
    "allowedCudaVersions": [
      "12.9",
      "12.8"
    ],
    "env": [
      {
        "key": "HF_MODEL",
        "input": {
          "type": "huggingface",
          "name": "Hugging Face Model",
          "description": "Model repo on the Hugging Face Hub",
          "default": "Qwen/Qwen-Image-2.1",
          "required": true
        }
      },
      {
        "key": "PRECISION",
        "input": {
          "name": "Model precision",
          "type": "string",
          "description": "Inference dtype (bf16 is recommended by the model card)",
          "options": [
            {
              "label": "BF16",
              "value": "bf16"
            },
            {
              "label": "FP16",
              "value": "fp16"
            }
          ],
          "default": "bf16"
        }
      },
      {
        "key": "QUANTIZATION",
        "input": {
          "name": "Quantization",
          "type": "string",
          "description": "Quantize the official weights at load time. none = BF16 (~33 GB VRAM), int8 (~18 GB), nf4 = 4-bit (~11 GB). Lower VRAM, lower quality, slower per image.",
          "options": [
            {
              "label": "None (BF16)",
              "value": "none"
            },
            {
              "label": "INT8",
              "value": "int8"
            },
            {
              "label": "NF4 (4-bit)",
              "value": "nf4"
            }
          ],
          "default": "none"
        }
      },
      {
        "key": "ENABLE_CPU_OFFLOAD",
        "input": {
          "name": "CPU offload",
          "type": "boolean",
          "description": "Offload components to CPU (needed for 24 GB GPUs, slower)",
          "default": false
        }
      },
      {
        "key": "DEFAULT_RESOLUTION",
        "input": {
          "name": "Default resolution",
          "type": "string",
          "description": "Size used when a request sets no resolution. 1k (~1 MP) costs about 4x less than 2k (~4 MP).",
          "options": [
            {
              "label": "1K (cheaper, faster)",
              "value": "1k"
            },
            {
              "label": "2K (model card)",
              "value": "2k"
            }
          ],
          "default": "1k"
        }
      },
      {
        "key": "DEFAULT_STEPS",
        "input": {
          "name": "Default steps",
          "type": "number",
          "description": "Denoising steps used when a request sets none. Fewer steps are faster and cheaper, with less detail.",
          "default": 40
        }
      },
      {
        "key": "HF_TOKEN",
        "input": {
          "name": "Hugging Face token",
          "type": "string",
          "description": "Optional, for gated/private repos and higher download rate limits",
          "default": ""
        }
      }
    ],
    "presets": [
      {
        "name": "48 GB+ GPU (fast)",
        "defaults": {
          "HF_MODEL": "Qwen/Qwen-Image-2.1",
          "PRECISION": "bf16",
          "ENABLE_CPU_OFFLOAD": false,
          "DEFAULT_RESOLUTION": "1k",
          "QUANTIZATION": "none"
        }
      },
      {
        "name": "24 GB GPU (INT8)",
        "defaults": {
          "HF_MODEL": "Qwen/Qwen-Image-2.1",
          "PRECISION": "bf16",
          "DEFAULT_RESOLUTION": "1k",
          "QUANTIZATION": "int8",
          "ENABLE_CPU_OFFLOAD": false
        }
      },
      {
        "name": "24 GB GPU (NF4 4-bit)",
        "defaults": {
          "HF_MODEL": "Qwen/Qwen-Image-2.1",
          "PRECISION": "bf16",
          "DEFAULT_RESOLUTION": "1k",
          "QUANTIZATION": "nf4",
          "ENABLE_CPU_OFFLOAD": false
        }
      }
    ]
  }
}
